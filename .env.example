# ─── Server ──────────────────────────────────────────────
PORT=3000
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# ─── Trading Mode ────────────────────────────────────────
LIVE_TRADING_ENABLED=false
DEMO_MODE=true

# ─── Signal Monitoring ───────────────────────────────────
SIGNAL_MONITOR_ENABLED=true
SIGNAL_SCAN_INTERVAL_SECONDS=60

# ─── Paper Trading ───────────────────────────────────────
PAPER_FEE_PERCENT=0.04
PAPER_MAX_OPEN_TRADES=3
PAPER_MAX_TOTAL_RISK_PERCENT=3
DEFAULT_RISK_PERCENT=1

# ─── Binance Futures ─────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ─── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── AI Service (Optional) ───────────────────────────────
AI_SERVICE_URL=http://localhost:11434/v1
AI_MODEL=llama3
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4

# ─── v2.0: Microstructure ────────────────────────────────
MICROSTRUCTURE_ENABLED=true
FUNDING_SPREAD_THRESHOLD_BPS=10

# ─── v2.0: Strategy Optimization ────────────────────────
OPTIMIZATION_MAX_ITERATIONS=200
OPTIMIZATION_WALK_FORWARD_FOLDS=5

# ─── v2.0: Health Monitoring ─────────────────────────────
ALERT_WEBHOOK_URL=
HEALTH_CHECK_INTERVAL_MS=30000
MEMORY_ALERT_THRESHOLD_MB=500

# ─── v2.0: Database ──────────────────────────────────────
DATA_FILE=./trading_brain.db

# ─── News Feeds ──────────────────────────────────────────
CRYPTO_NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# ─── Risk ────────────────────────────────────────────────
CIRCUIT_MIN_SAMPLE=10
CIRCUIT_MIN_WIN_RATE=25
CIRCUIT_MAX_LOSS_STREAK=3

# ─── CORS ────────────────────────────────────────────────
ALLOWED_ORIGIN=
